# API — NOTE: the API does NOT auto-load this file (no dotenv). Copy the values you need
# into your shell exports, or run: set -a; source .env; set +a   (bash/zsh). See README Quickstart.
PORT=3001
SESSION_SECRET=change-me-at-least-32-chars-long-random
DATABASE_PATH=./data/app.sqlite
# SQLite boot on SMB/Azure Files (refs DIN-25/DIN-30): each open attempt waits up to 5s for
# a lock, and the whole open+init retries with backoff for ~30s (SQLITE_BOOT_BUDGET_MS) to
# ride out a revision transition. SQLITE_JOURNAL_MODE only chooses the mode of a NEW
# database: an existing DB keeps the journal mode it already has (never forced at boot).
# DELETE (rollback journal) is the safe default on SMB; on trusted local disk you may set
# SQLITE_JOURNAL_MODE=WAL for the classic dev behaviour.
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_BOOT_BUDGET_MS=30000
SQLITE_JOURNAL_MODE=DELETE
# Solana / Jupiter (live, no keys needed for keyless tier)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK_URL=https://solana-rpc.publicnode.com
WALLET_DEVNET_RPC_URL=https://api.devnet.solana.com
AGENT_WALLET_ADDRESS=DbjQkyag5Fnb8tbWe2BFWFAXmYrn6qAWDqk5Uqv2pCcu
# Funded taker used ONLY to prove the Jupiter route simulates cleanly (spec 01 paper-substituted semantics are documented in README; never signs, never sends)
SIMULATION_PROOF_TAKER=2AQdpHJ2JpcEgPiATUXjQxA8QmafFegfQwSLWSprPicm
# Jamás prender sin fondeo + checklist KMS de spec 01
EXECUTION_ENABLED=false
EXECUTION_MODE=paper
AGENT_MODE=parser
GATE_TTL_MS=60000
QUOTE_TTL_MS=30000
SLIPPAGE_BPS=50
PAPER_FAUCET_CAP_USD=1000
PAPER_PER_PROPOSAL_CAP_USD=25
PAPER_DAILY_CAP_USD=50
# SSE (roadmap 1.1, DIN-35): tick de precios y heartbeat del stream /api/v1/events.
SSE_PRICE_TICK_MS=12000
SSE_HEARTBEAT_MS=20000
# Onda MCP (fase 1.2, spec 07): servidor MCP remoto en /mcp. Default apagado.
MCP_ENABLED=false
# Base pública para signingUrl (deep link a /confirm/<id>). Sin dominio propio, MCP queda staging-only (Q-M3).
PUBLIC_BASE_URL=http://localhost:5173
# Production same-origin serving (deploy/Dockerfile sets these; leave unset for local dev):
# SERVE_WEB=true serves the built web app from WEB_DIST on the API origin.
#SERVE_WEB=
#WEB_DIST=/app/apps/web/dist
